{
 "$comment": "Version 2 of tenant_docs: a nullable title, a looser level range, owner-immutable rows, owners may delete, and a per-tenant settings table. Used by `mls diff | migrate | preflight`.",
 "mls_version": "0.1",
 "identity": {
  "adapter": "supabase",
  "context": {
   "uid": {
    "source": "auth.uid",
    "type": "uuid"
   },
   "clearance": {
    "source": "jwt.claims.clearance",
    "type": "int"
   }
  }
 },
 "roles": [
  "authenticated"
 ],
 "tables": {
  "memberships": {
   "columns": {
    "user_id": {
     "type": "uuid",
     "nullable": false
    },
    "tenant_id": {
     "type": "int",
     "nullable": false
    }
   },
   "primary_key": [
    "user_id",
    "tenant_id"
   ]
  },
  "admins": {
   "columns": {
    "user_id": {
     "type": "uuid",
     "nullable": false
    },
    "tenant_id": {
     "type": "int",
     "nullable": false
    }
   },
   "primary_key": [
    "user_id",
    "tenant_id"
   ]
  },
  "docs": {
   "columns": {
    "id": {
     "type": "int",
     "nullable": false
    },
    "tenant_id": {
     "type": "int",
     "nullable": false
    },
    "owner_id": {
     "type": "uuid",
     "nullable": true
    },
    "level": {
     "type": "int",
     "nullable": false
    },
    "archived": {
     "type": "int",
     "nullable": true
    },
    "title": {
     "type": "text",
     "nullable": true
    }
   },
   "primary_key": [
    "id"
   ]
  },
  "tenant_settings": {
   "columns": {
    "tenant_id": {
     "type": "int",
     "nullable": false
    },
    "max_level": {
     "type": "int",
     "nullable": false
    }
   },
   "primary_key": [
    "tenant_id"
   ]
  }
 },
 "relations": {
  "member_of": {
   "table": "memberships",
   "key": "user_id",
   "value": "tenant_id"
  },
  "admin_of": {
   "table": "admins",
   "key": "user_id",
   "value": "tenant_id"
  }
 },
 "rules": [
  {
   "id": "R1",
   "requirement": "REQ-1",
   "kind": "policy",
   "name": "member_read",
   "table": "docs",
   "role": "authenticated",
   "command": "select",
   "mode": "permissive",
   "using": {
    "and": [
     {
      "member": {
       "relation": "member_of",
       "key": {
        "ctx": "uid"
       },
       "value": {
        "col": "tenant_id"
       }
      }
     },
     {
      "cmp": [
       {
        "col": "level"
       },
       "<=",
       {
        "ctx": "clearance"
       }
      ]
     }
    ]
   }
  },
  {
   "id": "R2",
   "requirement": "REQ-2",
   "kind": "policy",
   "name": "admin_read",
   "table": "docs",
   "role": "authenticated",
   "command": "select",
   "mode": "permissive",
   "using": {
    "member": {
     "relation": "admin_of",
     "key": {
      "ctx": "uid"
     },
     "value": {
      "col": "tenant_id"
     }
    }
   }
  },
  {
   "id": "R3",
   "requirement": "REQ-3",
   "kind": "policy",
   "name": "member_insert",
   "table": "docs",
   "role": "authenticated",
   "command": "insert",
   "mode": "permissive",
   "check": {
    "and": [
     {
      "member": {
       "relation": "member_of",
       "key": {
        "ctx": "uid"
       },
       "value": {
        "col": "tenant_id"
       }
      }
     },
     {
      "cmp": [
       {
        "col": "level"
       },
       "<=",
       {
        "ctx": "clearance"
       }
      ]
     }
    ]
   }
  },
  {
   "id": "R4",
   "requirement": "REQ-3",
   "kind": "policy",
   "name": "member_update",
   "table": "docs",
   "role": "authenticated",
   "command": "update",
   "mode": "permissive",
   "using": {
    "member": {
     "relation": "member_of",
     "key": {
      "ctx": "uid"
     },
     "value": {
      "col": "tenant_id"
     }
    }
   },
   "check": {
    "and": [
     {
      "member": {
       "relation": "member_of",
       "key": {
        "ctx": "uid"
       },
       "value": {
        "col": "tenant_id"
       }
      }
     },
     {
      "cmp": [
       {
        "col": "level"
       },
       "<=",
       {
        "ctx": "clearance"
       }
      ]
     }
    ]
   }
  },
  {
   "id": "R5",
   "requirement": "REQ-4",
   "kind": "policy",
   "name": "not_archived",
   "table": "docs",
   "role": "authenticated",
   "command": "all",
   "mode": "restrictive",
   "using": {
    "not": {
     "cmp": [
      {
       "col": "archived"
      },
      "=",
      {
       "const": 1
      }
     ]
    }
   }
  },
  {
   "id": "R6",
   "requirement": "REQ-5",
   "kind": "check",
   "name": "level_range",
   "table": "docs",
   "predicate": {
    "and": [
     {
      "cmp": [
       {
        "col": "level"
       },
       ">=",
       {
        "const": 0
       }
      ]
     },
     {
      "cmp": [
       {
        "col": "level"
       },
       "<=",
       {
        "const": 4
       }
      ]
     }
    ]
   }
  },
  {
   "id": "R7",
   "requirement": "REQ-6",
   "kind": "inclusion",
   "name": "owner_in_tenant",
   "table": "docs",
   "columns": [
    "owner_id",
    "tenant_id"
   ],
   "relation": "member_of",
   "on_delete": "restrict"
  },
  {
   "id": "R8",
   "requirement": "REQ-6",
   "kind": "inclusion",
   "name": "admin_is_member",
   "table": "admins",
   "columns": [
    "user_id",
    "tenant_id"
   ],
   "relation": "member_of",
   "on_delete": "restrict"
  },
  {
   "id": "R9",
   "requirement": "REQ-7",
   "kind": "transition",
   "name": "tenant_immutable",
   "table": "docs",
   "predicate": {
    "and": [
     {
      "cmp": [
       {
        "new": "tenant_id"
       },
       "=",
       {
        "old": "tenant_id"
       }
      ]
     },
     {
      "or": [
       {
        "is_null": {
         "old": "owner_id"
        }
       },
       {
        "cmp": [
         {
          "new": "owner_id"
         },
         "=",
         {
          "old": "owner_id"
         }
        ]
       }
      ]
     }
    ]
   }
  },
  {
   "id": "R10",
   "requirement": "REQ-8",
   "kind": "policy",
   "name": "owner_delete",
   "table": "docs",
   "role": "authenticated",
   "command": "delete",
   "mode": "permissive",
   "using": {
    "cmp": [
     {
      "col": "owner_id"
     },
     "=",
     {
      "ctx": "uid"
     }
    ]
   }
  },
  {
   "id": "R11",
   "requirement": "REQ-9",
   "kind": "check",
   "name": "title_not_blank",
   "table": "docs",
   "predicate": {
    "or": [
     {
      "is_null": {
       "col": "title"
      }
     },
     {
      "cmp": [
       {
        "col": "title"
       },
       "<>",
       {
        "const": ""
       }
      ]
     }
    ]
   }
  },
  {
   "id": "R12",
   "requirement": "REQ-10",
   "kind": "policy",
   "name": "settings_member_read",
   "table": "tenant_settings",
   "role": "authenticated",
   "command": "select",
   "mode": "permissive",
   "using": {
    "member": {
     "relation": "member_of",
     "key": {
      "ctx": "uid"
     },
     "value": {
      "col": "tenant_id"
     }
    }
   }
  },
  {
   "id": "R13",
   "requirement": "REQ-10",
   "kind": "check",
   "name": "max_level_range",
   "table": "tenant_settings",
   "predicate": {
    "and": [
     {
      "cmp": [
       {
        "col": "max_level"
       },
       ">=",
       {
        "const": 0
       }
      ]
     },
     {
      "cmp": [
       {
        "col": "max_level"
       },
       "<=",
       {
        "const": 4
       }
      ]
     }
    ]
   }
  }
 ],
 "properties": [
  {
   "id": "P1",
   "template": "tenant_isolation",
   "description": "a user only touches docs of tenants they belong to",
   "table": "docs",
   "column": "tenant_id",
   "relation": "member_of",
   "key": {
    "ctx": "uid"
   },
   "commands": [
    "select",
    "insert",
    "update",
    "delete"
   ]
  },
  {
   "id": "P2",
   "template": "column_immutable",
   "description": "a doc never changes tenant",
   "table": "docs",
   "column": "tenant_id"
  },
  {
   "id": "P3",
   "template": "monotone_in",
   "description": "removing a membership never grants access",
   "relation": "member_of"
  },
  {
   "id": "P4",
   "template": "invariant_preserved",
   "description": "levels stay in range, owners stay members, admins stay members",
   "invariants": [
    {
     "rule": "R6"
    },
    {
     "rule": "R7"
    },
    {
     "rule": "R8"
    },
    {
     "rule": "R11"
    }
   ]
  },
  {
   "id": "P5",
   "template": "write_subset_read",
   "description": "whatever a user writes, they can read back",
   "table": "docs"
  },
  {
   "id": "P6",
   "template": "least_privilege",
   "allowed": {
    "authenticated": {
     "docs": [
      "select",
      "insert",
      "update",
      "delete"
     ],
     "memberships": [
      "select"
     ],
     "admins": [
      "select"
     ],
     "tenant_settings": [
      "select"
     ]
    }
   }
  }
 ]
}