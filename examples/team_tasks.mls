mls 0.1
comment 'Ownership two and three tables away (D56): tasks belong to projects, projects to teams, comments to tasks. A team member reads the projects of their teams, reads and adds the tasks of those projects through the composed relation in_project, and reads the comments on those tasks through in_task, with no team_id copied onto tasks or comments.'

identity supabase { uid: auth.uid uuid }
roles authenticated

table team_members owned {
  user_id uuid not null,
  team_id bigint not null;
  primary_key (user_id, team_id)
}

table projects owned {
  id bigint not null,
  team_id bigint not null,
  name text not null;
  primary_key (id)
}

table tasks owned {
  id bigint not null,
  project_id bigint not null,
  title text not null,
  done bool not null;
  primary_key (id)
}

table comments owned {
  id bigint not null,
  task_id bigint not null,
  body text not null;
  primary_key (id)
}

relation member_of = team_members(user_id, team_id)
relation in_project = member_of . projects(team_id, id)
relation in_task = member_of . projects(team_id, id) . tasks(project_id, id)

rules {
  R1 policy member_reads_projects on projects: authenticated select permissive using member_of(@uid, team_id)
  R2 policy member_reads_tasks on tasks: authenticated select permissive using in_project(@uid, project_id)
  R3 policy member_adds_tasks on tasks: authenticated insert permissive check in_project(@uid, project_id)
  R4 policy member_reads_comments on comments: authenticated select permissive using in_task(@uid, task_id)
}

properties {
  P1 tenant_isolation tasks: project_id in in_project(@uid) for select description 'a user only reads the tasks of the projects of their own teams'
  P2 must_allow tasks authenticated select: in_project(@uid, project_id) description 'a member reads every task of every project of their teams'
  P3 tenant_isolation comments: task_id in in_task(@uid) for select description 'a user only reads the comments on tasks of their own teams'
  P4 must_allow comments authenticated select: in_task(@uid, task_id) description 'a member reads every comment on a task of their teams'
  P5 write_subset_read tasks description 'a member only adds tasks they can read'
}
