{
  "$comment": "ILLUSTRATIVE ONLY. The real schema is defined in Milestone 1. This mirrors prototype/demo.py and prototype/integrity.py.",
  "mls_version": "0.1",
  "identity": { "adapter": "supabase", "context": { "uid": "auth.uid", "clearance": "jwt.claims.clearance" } },
  "roles": ["authenticated"],
  "tables": {
    "memberships": { "columns": { "user_id": {"type": "uuid", "nullable": false}, "tenant_id": {"type": "int", "nullable": false} },
                     "primary_key": ["user_id", "tenant_id"] },
    "admins":      { "columns": { "user_id": {"type": "uuid", "nullable": false}, "tenant_id": {"type": "int", "nullable": false} } },
    "docs":        { "columns": { "id": {"type": "int", "nullable": false}, "tenant_id": {"type": "int", "nullable": false},
                                  "owner_id": {"type": "uuid", "nullable": true}, "level": {"type": "int", "nullable": false},
                                  "archived": {"type": "int", "nullable": true} },
                     "primary_key": ["id"] }
  },
  "relations": {
    "member_of": { "table": "memberships", "key": "user_id", "value": "tenant_id" },
    "admin_of":  { "table": "admins",      "key": "user_id", "value": "tenant_id" }
  },
  "rules": [
    { "id": "R1", "requirement": "REQ-1", "kind": "policy", "name": "member_read", "table": "docs", "role": "authenticated",
      "command": "select", "mode": "permissive",
      "using": { "and": [ { "member": { "relation": "member_of", "key": {"ctx": "uid"}, "value": {"col": "tenant_id"} } },
                          { "cmp": [ {"col": "level"}, "<=", {"ctx": "clearance"} ] } ] } },
    { "id": "R2", "requirement": "REQ-2", "kind": "policy", "name": "admin_read", "table": "docs", "role": "authenticated",
      "command": "select", "mode": "permissive",
      "using": { "member": { "relation": "admin_of", "key": {"ctx": "uid"}, "value": {"col": "tenant_id"} } } },
    { "id": "R3", "requirement": "REQ-3", "kind": "policy", "name": "member_update", "table": "docs", "role": "authenticated",
      "command": "update", "mode": "permissive",
      "using": { "member": { "relation": "member_of", "key": {"ctx": "uid"}, "value": {"col": "tenant_id"} } },
      "check": { "member": { "relation": "member_of", "key": {"ctx": "uid"}, "value": {"col": "tenant_id"} } } },
    { "id": "R4", "requirement": "REQ-4", "kind": "policy", "name": "not_archived", "table": "docs", "role": "authenticated",
      "command": "all", "mode": "restrictive",
      "using": { "not": { "cmp": [ {"col": "archived"}, "=", {"const": 1} ] } } },
    { "id": "R5", "requirement": "REQ-5", "kind": "check", "name": "level_range", "table": "docs",
      "predicate": { "and": [ { "cmp": [ {"col": "level"}, ">=", {"const": 0} ] }, { "cmp": [ {"col": "level"}, "<=", {"const": 3} ] } ] } },
    { "id": "R6", "requirement": "REQ-6", "kind": "inclusion", "name": "owner_in_tenant", "table": "docs",
      "columns": ["owner_id", "tenant_id"], "relation": "member_of", "on_delete": "restrict" },
    { "id": "R7", "requirement": "REQ-6", "kind": "inclusion", "name": "admin_is_member", "table": "admins",
      "columns": ["user_id", "tenant_id"], "relation": "member_of", "on_delete": "restrict" },
    { "id": "R8", "requirement": "REQ-7", "kind": "transition", "name": "tenant_immutable", "table": "docs",
      "predicate": { "cmp": [ {"new": "tenant_id"}, "=", {"old": "tenant_id"} ] } }
  ],
  "properties": [
    { "id": "P1", "template": "tenant_isolation", "table": "docs", "commands": ["select", "insert", "update"],
      "relation": "member_of", "column": "tenant_id" },
    { "id": "P2", "template": "column_immutable", "table": "docs", "column": "tenant_id" },
    { "id": "P3", "template": "monotone_in", "relation": "member_of" },
    { "id": "P4", "template": "invariant_preserved", "rules": ["R5", "R6", "R7"] }
  ]
}
