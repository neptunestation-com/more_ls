{
 "$comment": "soft deletion without the hiding policy",
 "mls_version": "0.1",
 "identity": {
  "adapter": "supabase",
  "context": {
   "uid": {
    "source": "auth.uid",
    "type": "uuid"
   }
  }
 },
 "roles": [
  "authenticated"
 ],
 "tables": {
  "memberships": {
   "columns": {
    "user_id": {
     "type": "uuid",
     "nullable": false
    },
    "tenant_id": {
     "type": "int",
     "nullable": false
    }
   },
   "primary_key": [
    "user_id",
    "tenant_id"
   ]
  },
  "notes": {
   "columns": {
    "id": {
     "type": "int",
     "nullable": false
    },
    "tenant_id": {
     "type": "int",
     "nullable": false
    },
    "deleted_at": {
     "type": "timestamp",
     "nullable": true
    },
    "body": {
     "type": "text",
     "nullable": false
    }
   },
   "primary_key": [
    "id"
   ]
  }
 },
 "relations": {
  "member_of": {
   "table": "memberships",
   "key": "user_id",
   "value": "tenant_id"
  }
 },
 "rules": [
  {
   "id": "R1",
   "kind": "policy",
   "name": "member_read",
   "table": "notes",
   "role": "authenticated",
   "command": "select",
   "mode": "permissive",
   "using": {
    "member": {
     "relation": "member_of",
     "key": {
      "ctx": "uid"
     },
     "value": {
      "col": "tenant_id"
     }
    }
   },
   "requirement": "members read"
  },
  {
   "id": "R3",
   "kind": "policy",
   "name": "member_insert",
   "table": "notes",
   "role": "authenticated",
   "command": "insert",
   "mode": "permissive",
   "check": {
    "and": [
     {
      "member": {
       "relation": "member_of",
       "key": {
        "ctx": "uid"
       },
       "value": {
        "col": "tenant_id"
       }
      }
     },
     {
      "is_null": {
       "col": "deleted_at"
      }
     }
    ]
   },
   "requirement": "members write"
  },
  {
   "id": "R4",
   "kind": "policy",
   "name": "member_update",
   "table": "notes",
   "role": "authenticated",
   "command": "update",
   "mode": "permissive",
   "using": {
    "and": [
     {
      "member": {
       "relation": "member_of",
       "key": {
        "ctx": "uid"
       },
       "value": {
        "col": "tenant_id"
       }
      }
     },
     {
      "is_null": {
       "col": "deleted_at"
      }
     }
    ]
   },
   "check": {
    "member": {
     "relation": "member_of",
     "key": {
      "ctx": "uid"
     },
     "value": {
      "col": "tenant_id"
     }
    }
   },
   "requirement": "members edit and soft-delete"
  },
  {
   "id": "R5",
   "kind": "transition",
   "name": "tenant_immutable",
   "table": "notes",
   "predicate": {
    "or": [
     {
      "and": [
       {
        "is_null": {
         "old": "tenant_id"
        }
       },
       {
        "is_null": {
         "new": "tenant_id"
        }
       }
      ]
     },
     {
      "cmp": [
       {
        "new": "tenant_id"
       },
       "=",
       {
        "old": "tenant_id"
       }
      ]
     }
    ]
   }
  }
 ],
 "properties": [
  {
   "id": "P1",
   "template": "tenant_isolation",
   "description": "notes are only seen and changed within the member's tenants",
   "table": "notes",
   "column": "tenant_id",
   "relation": "member_of",
   "key": {
    "ctx": "uid"
   },
   "commands": [
    "select",
    "insert",
    "update"
   ]
  },
  {
   "id": "P2",
   "template": "custom",
   "description": "a deleted note is never visible",
   "table": "notes",
   "role": "authenticated",
   "command": "select",
   "which": "new",
   "goal": {
    "is_null": {
     "col": "deleted_at"
    }
   }
  },
  {
   "id": "P3",
   "template": "custom",
   "description": "a deleted note is never modified",
   "table": "notes",
   "role": "authenticated",
   "command": "update",
   "which": "old",
   "goal": {
    "is_null": {
     "col": "deleted_at"
    }
   }
  },
  {
   "id": "P4",
   "template": "monotone_in",
   "description": "leaving a tenant never grants access",
   "relation": "member_of"
  },
  {
   "id": "P5",
   "template": "least_privilege",
   "description": "no hard delete",
   "allowed": {
    "authenticated": {
     "notes": [
      "select",
      "insert",
      "update"
     ],
     "memberships": [
      "select"
     ]
    }
   }
  },
  {
   "id": "P6",
   "template": "must_allow",
   "description": "a member reads the live notes of their tenants",
   "table": "notes",
   "role": "authenticated",
   "command": "select",
   "when": {
    "and": [
     {
      "member": {
       "relation": "member_of",
       "key": {
        "ctx": "uid"
       },
       "value": {
        "col": "tenant_id"
       }
      }
     },
     {
      "is_null": {
       "col": "deleted_at"
      }
     }
    ]
   }
  },
  {
   "id": "P7",
   "template": "must_allow",
   "description": "a member creates a live note in their tenant",
   "table": "notes",
   "role": "authenticated",
   "command": "insert",
   "when": {
    "and": [
     {
      "member": {
       "relation": "member_of",
       "key": {
        "ctx": "uid"
       },
       "value": {
        "col": "tenant_id"
       }
      }
     },
     {
      "is_null": {
       "col": "deleted_at"
      }
     }
    ]
   }
  },
  {
   "id": "P8",
   "template": "must_allow",
   "description": "a member soft-deletes a live note of their tenant",
   "table": "notes",
   "role": "authenticated",
   "command": "update",
   "when": {
    "and": [
     {
      "member": {
       "relation": "member_of",
       "key": {
        "ctx": "uid"
       },
       "value": {
        "old": "tenant_id"
       }
      }
     },
     {
      "is_null": {
       "old": "deleted_at"
      }
     },
     {
      "not": {
       "is_null": {
        "new": "deleted_at"
       }
      }
     },
     {
      "cmp": [
       {
        "new": "id"
       },
       "=",
       {
        "old": "id"
       }
      ]
     },
     {
      "cmp": [
       {
        "new": "tenant_id"
       },
       "=",
       {
        "old": "tenant_id"
       }
      ]
     },
     {
      "cmp": [
       {
        "new": "body"
       },
       "=",
       {
        "old": "body"
       }
      ]
     }
    ]
   }
  }
 ]
}
