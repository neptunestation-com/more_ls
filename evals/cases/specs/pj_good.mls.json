{
 "$comment": "projects, members, assignees",
 "mls_version": "0.1",
 "identity": {
  "adapter": "supabase",
  "context": {
   "uid": {
    "source": "auth.uid",
    "type": "uuid"
   }
  }
 },
 "roles": [
  "authenticated"
 ],
 "tables": {
  "projects": {
   "columns": {
    "id": {
     "type": "int",
     "nullable": false
    },
    "owner_id": {
     "type": "uuid",
     "nullable": false
    }
   },
   "primary_key": [
    "id"
   ]
  },
  "project_members": {
   "columns": {
    "user_id": {
     "type": "uuid",
     "nullable": false
    },
    "project_id": {
     "type": "int",
     "nullable": false
    }
   },
   "primary_key": [
    "user_id",
    "project_id"
   ]
  },
  "tasks": {
   "columns": {
    "id": {
     "type": "int",
     "nullable": false
    },
    "project_id": {
     "type": "int",
     "nullable": false
    },
    "assignee_id": {
     "type": "uuid",
     "nullable": true
    },
    "done": {
     "type": "bool",
     "nullable": false
    }
   },
   "primary_key": [
    "id"
   ]
  }
 },
 "relations": {
  "member_of": {
   "table": "project_members",
   "key": "user_id",
   "value": "project_id"
  }
 },
 "rules": [
  {
   "id": "R1",
   "kind": "policy",
   "name": "member_read",
   "table": "tasks",
   "role": "authenticated",
   "command": "select",
   "mode": "permissive",
   "using": {
    "member": {
     "relation": "member_of",
     "key": {
      "ctx": "uid"
     },
     "value": {
      "col": "project_id"
     }
    }
   },
   "requirement": "members see tasks of their projects"
  },
  {
   "id": "R2",
   "kind": "policy",
   "name": "member_insert",
   "table": "tasks",
   "role": "authenticated",
   "command": "insert",
   "mode": "permissive",
   "check": {
    "member": {
     "relation": "member_of",
     "key": {
      "ctx": "uid"
     },
     "value": {
      "col": "project_id"
     }
    }
   },
   "requirement": "members add tasks"
  },
  {
   "id": "R3",
   "kind": "policy",
   "name": "assignee_update",
   "table": "tasks",
   "role": "authenticated",
   "command": "update",
   "mode": "permissive",
   "using": {
    "and": [
     {
      "member": {
       "relation": "member_of",
       "key": {
        "ctx": "uid"
       },
       "value": {
        "col": "project_id"
       }
      }
     },
     {
      "cmp": [
       {
        "col": "assignee_id"
       },
       "=",
       {
        "ctx": "uid"
       }
      ]
     }
    ]
   },
   "check": {
    "member": {
     "relation": "member_of",
     "key": {
      "ctx": "uid"
     },
     "value": {
      "col": "project_id"
     }
    }
   },
   "requirement": "assignees update their tasks"
  },
  {
   "id": "R4",
   "kind": "inclusion",
   "name": "assignee_is_member",
   "table": "tasks",
   "columns": [
    "assignee_id",
    "project_id"
   ],
   "relation": "member_of",
   "on_delete": "restrict",
   "requirement": "assignees are members"
  }
 ],
 "properties": [
  {
   "id": "P1",
   "template": "tenant_isolation",
   "description": "tasks are only seen, added and changed by members of their project",
   "table": "tasks",
   "column": "project_id",
   "relation": "member_of",
   "key": {
    "ctx": "uid"
   },
   "commands": [
    "select",
    "insert",
    "update"
   ]
  },
  {
   "id": "P2",
   "template": "custom",
   "description": "only the assignee updates a task",
   "table": "tasks",
   "role": "authenticated",
   "command": "update",
   "which": "old",
   "goal": {
    "cmp": [
     {
      "col": "assignee_id"
     },
     "=",
     {
      "ctx": "uid"
     }
    ]
   }
  },
  {
   "id": "P3",
   "template": "monotone_in",
   "description": "leaving a project never grants access",
   "relation": "member_of"
  },
  {
   "id": "P4",
   "template": "invariant_preserved",
   "description": "an assignee is always a member of the task's project",
   "invariants": [
    {
     "rule": "R4"
    }
   ]
  },
  {
   "id": "P5",
   "template": "write_subset_read",
   "description": "whatever is written can be read back",
   "table": "tasks"
  },
  {
   "id": "P6",
   "template": "least_privilege",
   "description": "only select/insert/update on tasks and select on project_members",
   "allowed": {
    "authenticated": {
     "tasks": [
      "select",
      "insert",
      "update"
     ],
     "project_members": [
      "select"
     ]
    }
   }
  },
  {
   "id": "P7",
   "template": "must_allow",
   "description": "a member reads the tasks of their projects",
   "table": "tasks",
   "role": "authenticated",
   "command": "select",
   "when": {
    "member": {
     "relation": "member_of",
     "key": {
      "ctx": "uid"
     },
     "value": {
      "col": "project_id"
     }
    }
   }
  },
  {
   "id": "P8",
   "template": "must_allow",
   "description": "a member adds an unassigned task to their project",
   "table": "tasks",
   "role": "authenticated",
   "command": "insert",
   "when": {
    "and": [
     {
      "member": {
       "relation": "member_of",
       "key": {
        "ctx": "uid"
       },
       "value": {
        "col": "project_id"
       }
      }
     },
     {
      "is_null": {
       "col": "assignee_id"
      }
     }
    ]
   }
  },
  {
   "id": "P9",
   "template": "must_allow",
   "description": "an assignee marks their task done",
   "table": "tasks",
   "role": "authenticated",
   "command": "update",
   "when": {
    "and": [
     {
      "member": {
       "relation": "member_of",
       "key": {
        "ctx": "uid"
       },
       "value": {
        "old": "project_id"
       }
      }
     },
     {
      "cmp": [
       {
        "old": "assignee_id"
       },
       "=",
       {
        "ctx": "uid"
       }
      ]
     },
     {
      "cmp": [
       {
        "new": "assignee_id"
       },
       "=",
       {
        "old": "assignee_id"
       }
      ]
     },
     {
      "cmp": [
       {
        "new": "id"
       },
       "=",
       {
        "old": "id"
       }
      ]
     },
     {
      "cmp": [
       {
        "new": "project_id"
       },
       "=",
       {
        "old": "project_id"
       }
      ]
     },
     {
      "cmp": [
       {
        "new": "done"
       },
       "=",
       {
        "const": true
       }
      ]
     }
    ]
   }
  }
 ]
}
