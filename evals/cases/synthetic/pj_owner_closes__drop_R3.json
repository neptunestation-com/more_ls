      "relation": "member_of",
      "key": {
       "ctx": "uid"
      },
      "value": {
       "col": "project_id"
      }
     }
    }
   },
   {
    "id": "P8",
    "description": "a member adds an unassigned task to their project",
    "template": "must_allow",
    "table": "tasks",
    "role": "authenticated",
    "command": "insert",
    "when": {
     "and": [
      {
       "member": {
        "relation": "member_of",
        "key": {
         "ctx": "uid"
        },
        "value": {
         "col": "project_id"
        }
       }
      },
      {
       "is_null": {
        "col": "assignee_id"
       }
      }
     ]
    }
   },
   {
    "id": "P9",
    "description": "an assignee marks their task done",
    "template": "must_allow",
    "table": "tasks",
    "role": "authenticated",
    "command": "update",
    "when": {
     "and": [
      {
       "member": {
        "relation": "member_of",
        "key": {
         "ctx": "uid"
        },
        "value": {
         "old": "project_id"
        }
       }
      },
      {
       "cmp": [
        {
         "old": "assignee_id"
        },
        "=",
        {
         "ctx": "uid"
        }
       ]
      },
      {
       "cmp": [
        {
         "new": "assignee_id"
        },
        "=",
        {
         "old": "assignee_id"
        }
       ]
      },
      {
       "cmp": [
        {
         "new": "id"
        },
        "=",
        {
         "old": "id"
        }
       ]
      },
      {
       "cmp": [
        {
         "new": "project_id"
        },
        "=",
        {
         "old": "project_id"
        }
       ]
      },
      {
       "cmp": [
        {
         "new": "done"
        },
        "=",
        {
         "const": true
        }
       ]
      }
     ]
    }
   },
   {
    "id": "P10",
    "description": "a project owner deletes any task of their project",
    "template": "must_allow",
    "table": "tasks",
    "role": "authenticated",
    "command": "delete",
    "when": {
     "member": {
      "relation": "owner_of",
      "key": {
       "ctx": "uid"
      },
      "value": {
       "col": "project_id"
      }
     }
    }
   }
  ]
