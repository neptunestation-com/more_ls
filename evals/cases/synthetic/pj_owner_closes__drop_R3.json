      "rule": "R6"
     }
    ]
   },
   {
    "id": "P5",
    "description": "whatever is written can be read back",
    "template": "write_subset_read",
    "table": "tasks"
   },
   {
    "id": "P6",
    "description": "only select/insert/update/delete on tasks, select on members and owners",
    "template": "least_privilege",
    "allowed": {
