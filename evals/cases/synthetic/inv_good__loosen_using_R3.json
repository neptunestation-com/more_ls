{
 "id": "inv_good__loosen_using_R3",
 "origin": "synthetic",
 "base_case": "inv_good",
 "mutation": "loosen_using:R3",
 "requirements": "Members of a tenant may invite others: an invite belongs to the tenant, records who created it and may carry an expiry time, which must still lie ahead when the invite is created. Members see the invites of their tenants, but never an expired one. Only the inviter, while still a member of the tenant, may revoke (delete) an invite. Invites are never edited.",
 "expected_properties": [
  "Invites are only seen, created and revoked within the member's tenants.",
  "An expired invite is never visible.",
  "Only the inviter revokes an invite.",
  "Leaving a tenant never grants access.",
  "The application role may only select/insert/delete invites and select memberships.",
  "A member can read the unexpired invites of their tenants.",
  "A member can create an unexpired invite in their own name.",
  "The inviter, while a member, can revoke their invite."
 ],
