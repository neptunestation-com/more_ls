 "id": "mk_good__drop_R9",
 "origin": "synthetic",
 "base_case": "mk_good",
 "mutation": "drop:R9",
 "requirements": "Sellers create listings with a status and a price; a listing's seller never changes and prices are never negative. Every signed-in user sees active listings; sellers also see and edit their own listings whatever the status, but a listing keeps its id. Buyers place orders on listings and see only their own orders. Nothing is deleted.",
 "expected_properties": [
  "A listing is visible only when active or to its seller.",
  "A listing's seller never changes.",
  "Prices are never negative.",
  "An order is visible only to its buyer.",
  "Only the seller changes a listing.",
  "Whatever is written can be read back.",
  "The application role may only select/insert/update listings and select/insert orders.",
  "Every signed-in user can read active listings.",
  "A seller can read their own listings.",
  "A seller can create a listing with a non-negative price.",
  "A seller can reprice their listing.",
  "A buyer can place an order in their own name.",
  "A buyer can read their own orders.",
  "A listing's id never changes."
 ],
