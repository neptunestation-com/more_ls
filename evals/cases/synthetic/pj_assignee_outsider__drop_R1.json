{
 "id": "pj_assignee_outsider__drop_R1",
 "origin": "synthetic",
 "base_case": "pj_assignee_outsider",
 "mutation": "drop:R1",
 "requirements": "Projects have members (project_members). Members see the tasks of their projects and may add tasks to them. A task may be assigned to a user, who need not be a member of the project; only the assignee may update a task, and may move it to any project. Nobody deletes tasks.",
 "expected_properties": [
  "Tasks are only seen, added and changed by members of their project.",
  "Only the assignee updates a task.",
  "Leaving a project never grants access.",
  "An assignee is always a member of the task's project.",
  "Whatever is written can be read back.",
  "The application role may only select/insert/update tasks and select project_members.",
  "A member can read the tasks of their projects.",
  "A member can add an unassigned task to their project.",
  "An assignee can mark their task done."
 ],
 "reference_spec": {
  "$comment": "projects where the assignee need not be a member and updates only check the assignee",
  "mls_version": "0.1",
  "identity": {
   "adapter": "supabase",
   "context": {
    "uid": {
     "source": "auth.uid",
     "type": "uuid"
    }
   }
  },
  "roles": [
   "authenticated"
  ],
  "tables": {
   "projects": {
    "columns": {
     "id": {
      "type": "int",
      "nullable": false
     },
     "owner_id": {
      "type": "uuid",
      "nullable": false
     }
    },
    "primary_key": [
     "id"
    ],
    "unique": []
   },
   "project_members": {
    "columns": {
     "user_id": {
      "type": "uuid",
      "nullable": false
     },
     "project_id": {
      "type": "int",
      "nullable": false
     }
    },
    "primary_key": [
     "user_id",
     "project_id"
    ],
    "unique": []
   },
   "tasks": {
    "columns": {
     "id": {
      "type": "int",
      "nullable": false
     },
     "project_id": {
      "type": "int",
      "nullable": false
     },
     "assignee_id": {
      "type": "uuid",
      "nullable": true
     },
     "done": {
      "type": "bool",
      "nullable": false
     }
    },
    "primary_key": [
     "id"
    ],
    "unique": []
   }
  },
  "relations": {
   "member_of": {
    "table": "project_members",
    "key": "user_id",
    "value": "project_id"
   }
  },
  "hierarchies": {},
  "opaques": {},
  "rules": [
   {
    "id": "R1",
    "name": "member_read",
    "table": "tasks",
    "kind": "policy",
    "role": "authenticated",
    "command": "select",
    "mode": "permissive",
    "using": {
     "member": {
      "relation": "member_of",
      "key": {
       "ctx": "uid"
      },
      "value": {
       "col": "project_id"
      }
     }
    }
   },
   {
    "id": "R2",
    "name": "member_insert",
    "table": "tasks",
    "kind": "policy",
    "role": "authenticated",
    "command": "insert",
    "mode": "permissive",
    "check": {
     "member": {
      "relation": "member_of",
      "key": {
       "ctx": "uid"
      },
      "value": {
       "col": "project_id"
      }
     }
    }
   },
   {
    "id": "R3",
    "name": "assignee_update",
    "table": "tasks",
    "kind": "policy",
    "role": "authenticated",
    "command": "update",
    "mode": "permissive",
    "using": {
     "cmp": [
      {
       "col": "assignee_id"
      },
      "=",
      {
       "ctx": "uid"
      }
     ]
    },
    "check": {
     "cmp": [
      {
       "col": "assignee_id"
      },
      "=",
      {
       "ctx": "uid"
      }
     ]
    }
   }
  ],
  "properties": [
   {
    "id": "P1",
    "description": "tasks are only seen, added and changed by members of their project",
    "template": "tenant_isolation",
    "table": "tasks",
    "column": "project_id",
    "relation": "member_of",
    "key": {
     "ctx": "uid"
    },
    "commands": [
     "select",
     "insert",
     "update"
    ]
   },
   {
    "id": "P2",
    "description": "only the assignee updates a task",
    "template": "custom",
    "table": "tasks",
    "role": "authenticated",
    "command": "update",
    "which": "old",
    "goal": {
     "cmp": [
      {
       "col": "assignee_id"
      },
      "=",
      {
       "ctx": "uid"
      }
     ]
    }
   },
   {
    "id": "P3",
    "description": "leaving a project never grants access",
    "template": "monotone_in",
    "relation": "member_of"
   },
   {
    "id": "P5",
    "description": "whatever is written can be read back",
    "template": "write_subset_read",
    "table": "tasks"
   },
   {
    "id": "P6",
    "description": "only select/insert/update on tasks and select on project_members",
    "template": "least_privilege",
    "allowed": {
     "authenticated": {
      "tasks": [
       "select",
       "insert",
       "update"
      ],
      "project_members": [
       "select"
      ]
     }
    }
   },
   {
    "id": "P7",
    "description": "a member reads the tasks of their projects",
    "template": "must_allow",
    "table": "tasks",
    "role": "authenticated",
    "command": "select",
    "when": {
     "member": {
      "relation": "member_of",
      "key": {
       "ctx": "uid"
      },
      "value": {
       "col": "project_id"
      }
     }
    }
   },
   {
    "id": "P8",
    "description": "a member adds an unassigned task to their project",
    "template": "must_allow",
    "table": "tasks",
    "role": "authenticated",
    "command": "insert",
    "when": {
     "and": [
      {
       "member": {
        "relation": "member_of",
        "key": {
         "ctx": "uid"
        },
        "value": {
         "col": "project_id"
        }
       }
      },
      {
       "is_null": {
        "col": "assignee_id"
       }
      }
     ]
    }
   },
   {
    "id": "P9",
    "description": "an assignee marks their task done",
    "template": "must_allow",
    "table": "tasks",
    "role": "authenticated",
    "command": "update",
    "when": {
     "and": [
      {
       "member": {
        "relation": "member_of",
        "key": {
         "ctx": "uid"
        },
        "value": {
         "old": "project_id"
        }
       }
      },
      {
       "cmp": [
        {
         "old": "assignee_id"
        },
        "=",
        {
         "ctx": "uid"
        }
       ]
      },
      {
       "cmp": [
        {
         "new": "assignee_id"
        },
        "=",
        {
         "old": "assignee_id"
        }
       ]
      },
      {
       "cmp": [
        {
         "new": "id"
        },
        "=",
        {
         "old": "id"
        }
       ]
      },
      {
       "cmp": [
        {
         "new": "project_id"
        },
        "=",
        {
         "old": "project_id"
        }
       ]
      },
      {
       "cmp": [
        {
         "new": "done"
        },
        "=",
        {
         "const": true
        }
       ]
      }
     ]
    }
   }
  ]
 },
 "expected_verdicts": {
  "P1": "REFUTED",
  "P2": "PROVED",
  "P3": "PROVED",
  "P5": "REFUTED",
  "P6": "PROVED",
  "P7": "PROVED",
  "P8": "PROVED",
  "P9": "PROVED"
 },
